{
    "compilerOptions": {
        "lib": ["es2023"],
        "types": ["node"],
        "target": "es2022",
        "module": "node16",
        "strict": true,
        "forceConsistentCasingInFileNames": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "moduleResolution": "node16",
        "rootDir": "src",
        "outDir": "dist",
        "declaration": true,
        "emitDecoratorMetadata": true,
        "experimentalDecorators": true
    },
    "include": ["src/**/*"],
    "exclude": ["src/**/*.test.ts"]
}
