{
    "compilerOptions": {
        "lib": ["es2023"],
        "types": ["node"],
        "target": "es2022",
        "module": "node16",
        "strict": true,
        "sourceMap": true,
        "inlineSources": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "moduleResolution": "node16",
        "rootDir": "src",
        "outDir": "dist",
        "declaration": true,
        "emitDecoratorMetadata": true,
        "experimentalDecorators": true
    },
    "include": ["src/**/*"]
}
